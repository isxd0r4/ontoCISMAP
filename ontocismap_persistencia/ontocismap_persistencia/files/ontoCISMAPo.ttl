###  http://example.org/OntoCISMAP#TranstornoDepressivo
:TranstornoDepressivo rdf:type owl:Class ;
                      rdfs:subClassOf gufo:FunctionalComplex ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf gufo:inheresIn
                                                       ] ;
                                        owl:someValuesFrom :SintomaDeTranstornoDepressivo
                                      ] ,
                                      [ rdf:type owl:Restriction ;
                                        owl:onProperty [ owl:inverseOf gufo:manifestedIn
                                                       ] ;
                                        owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                        owl:onClass :TranstornoDepressivoManifestado
                                      ] .


###  http://example.org/OntoCISMAP#TranstornoDepressivoManifestado
:TranstornoDepressivoManifestado rdf:type owl:Class ;
                                 rdfs:subClassOf gufo:IntrinsicMode ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty gufo:inheresIn ;
                                                   owl:someValuesFrom :SintomaDeTranstornoDepressivoManifestado
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty gufo:inheresIn ;
                                                   owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :Gestante
                                                 ] ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty gufo:manifestedIn ;
                                                   owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                   owl:onClass :TranstornoDepressivo
                                                 ] .



@base <http://example.org/OntoCISMAP#> .

<http://example.org/OntoCISMAP> rdf:type owl:Ontology ;
                                 owl:imports gufo: .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/1999/02/22-rdf-syntax-ns#label
rdf:label rdf:type owl:AnnotationProperty .



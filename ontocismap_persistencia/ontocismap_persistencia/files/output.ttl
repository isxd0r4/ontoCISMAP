:Pontuacao a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pontuacao"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Pergunta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Quantity .

:Pergunta a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pergunta"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:EscalaDeEdimburgo a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Escala de Edimburgo"@en ;
    rdfs:subClassOf :Questionario .

:EscalaDePittsburgh a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Escala de Pittsburgh"@en ;
    rdfs:subClassOf :Questionario .

:QuestionarioAUDIT a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Questionario AUDIT"@en ;
    rdfs:subClassOf :Questionario .

:TesteDeFergstron a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Teste de Fergstron"@en ;
    rdfs:subClassOf :Questionario .

:AplicacaoDaEscalaOHIP14 a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aplicacao da Escala OHIP-14"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Resposta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Resultado ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:AplicacaoDaEscalaDePittsburgh a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aplicacao da Escala de Pittsburgh"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Resposta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Resultado ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:AplicacaoDoQuestionarioAUDIT a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aplicacao do Questionario AUDIT"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Resposta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Resultado ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:AplicacaoDoTesteDeFergstron a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aplicacao do Teste de Fergstron"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Resposta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Resultado ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:EscalaOHIP14 a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Escala OHIP-14"@en ;
    rdfs:subClassOf :Questionario .

:AplicacaoDaEscalaDeEdimburgo a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aplicacao da Escala de Edimburgo "@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Gestante ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ProfissionalDeSaude ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:onClass :Resposta ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Resultado ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:Gestante a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Gestante"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoDosHabitosAlimentares ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoDosHabitosDeVida ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoPsicossocialDaGestante ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :CorteVaginal ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SintomaDeTranstornoDepressivoManifestado ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDeVacina ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Dialogo ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Gestacao ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :RelacaoSexualDuranteAGestacao ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Tratamento ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ViolenciaDomestica ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ViolenciaObstetrica ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDoInstrumentoDeElegibilidade ;
            owl:onProperty [ owl:inverseOf gufo:participatedIn ] ],
        [ a owl:Restriction ;
            owl:onClass :PreNatalOdontologico ;
            owl:onProperty gufo:mediates ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Alimentacao ;
            owl:onProperty gufo:participatedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :TrabalhoDeParto ;
            owl:onProperty gufo:participatedIn ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :DisposicaoSexualDuranteAGestacao ;

:NivelDeAtividadeFisicaRealizada a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Nivel de Atividade Fisica Realizada"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :RealizacaoDeAtividadeFisica ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .

:ProblemaDeSaude a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Problema de Saude"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:manifestedIn ] ;
            owl:someValuesFrom :ProblemaDeSaudeManifestado ],
        gufo:FunctionalComplex .

:Corpo a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Corpo"@en ;
    rdfs:subClassOf gufo:Quality .

:SintomaDeDependenciaDeBebidaAlcoolica a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sintoma De Dependencia de Bebida Alcoolica"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DependenciaDeBebidaAlcoolica ;
            owl:onProperty gufo:inheresIn ],
        :Sintoma .

:SintomaDeTranstornoDepressivo a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sintoma de Transtorno Depressivo"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :TranstornoDepressivo ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SintomaDeTranstornoDepressivoManifestado ;
            owl:onProperty [ owl:inverseOf gufo:manifestedIn ] ],
        :Sintoma .

:SinalDeAlerta a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sinal de Alerta"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:Vacina a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Vacina"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :EsquemaVacinal ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:FunctionalComplex .


:AbortoEspontaneo a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aborto Espontaneo"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :CausaDoAborto ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Aborto .

:Acompanhante a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Acompanhante"@en ;
    rdfs:subClassOf :Pessoa .

:Anemia a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Anemia"@en ;
    rdfs:subClassOf :ProblemaDeSaudeNoSistemaHematologico .

:ApresentacaoFetal a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Apresentacao Fetal"@en ;
    rdfs:subClassOf :ParametroFetal .

:AspectoDaSecrecao a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aspecto da Secrecao"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :PresencaDeSecrecao ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .

:AtendimentoEspecializado a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Atendimento Especializado"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :GestanteDeAltoRisco ;
            owl:onProperty [ owl:inverseOf gufo:participatedIn ] ],
        gufo:Event .

:AvaliacaoDaMama a gufo:SubKind,

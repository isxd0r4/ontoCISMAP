            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :OdorFetido ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :PresencaDeSecrecao ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SinalFlogistico ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        gufo:FunctionalComplex .

:MetodoNaoFarmacologico a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Metodo Nao Farmacologico"@en ;
    rdfs:subClassOf :MetodoParaAlivioDaDor .

:NivelDeEscolaridade a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Nivel de Escolaridade"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :analfabetoFundamentalIncompleto :fundamentalICompletoFundamentalIIIncompleto :fundamentalIICompletoEnsinoMedioIncompleto :medioCompletoSuperiorIncompleto :superiorCompleto ) ] .

:Piso a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Piso"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :ceramica :concreto :lajota :pisoEmTerraBatida :tijolo ) ] .

:PreNatalOdontologico a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Pre-Natal Odontologico"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ProfissionalDeSaude ;
            owl:onProperty gufo:mediates ],
        gufo:Relator .

:ProblemaDeSaudeNoSistemaReprodutor a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Problema de Saude no Sistema Reprodutor"@en ;
    rdfs:subClassOf :Fisico,
        :ProblemaDeSaude .

:RacaCorIBGE a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Raca/Cor IBGE"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :amarelo :branco :indigena :pardo :preto ) ] .

:Sintoma a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sintoma"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :Frequencia ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:IntrinsicMode .

:SistemaEOR a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sistema EOR"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onClass :ProfissionalDeSaude ;
            owl:onProperty [ owl:inverseOf :utiliza ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:FunctionalComplex .


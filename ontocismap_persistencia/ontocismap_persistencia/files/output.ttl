:sintoma13_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "teve dor" .

:sintoma14_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "outras razões" .

:sintoma15_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "durante o último mês, como você classificaria a qualidade do seu sono de uma maneira geral?" .

:sintoma16_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "durante o último mês, com que frequência você tomou medicamento para lher ajudar a dormir?" .

:sintoma17_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "no último mês, com que frequência você teve dificuldade de ficar acordado enquanto dirigia, comia ou participava de uma atividade social?" .

:sintoma18_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "durante o último mês, quão problemático foi para você manter o entusiasmo para fazer as coisas?" .

:sintoma19_pittsburgh a :SintomaDeDisturbioDoSono,
        owl:NamedIndividual ;
    rdfs:label "você tem um parceiro ou colega de quarto?" .

:sintoma20_pittsburgh a :SintomaDeDisturbioDoSono,

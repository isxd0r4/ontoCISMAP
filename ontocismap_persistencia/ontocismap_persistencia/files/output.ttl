:ImpactoDaSaudeBucalNaQualidadeDeVida a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Impacto da Saude Bucal na Qualidade de Vida"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AmbienteDeVivenciaPessoal ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :QualidadeDeVidaDaGestante ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SaudeBucalDaGestante ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:onClass :Frequencia ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:ProfissionalDeSaude a gufo:Role,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Profissional de Saude"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoDosHabitosAlimentares ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoDosHabitosDeVida ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :AvaliacaoPsicossocialDaGestante ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :ExecucaoDeProjetoDeDesenvolvimentoTecnologico ],
        [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:someValuesFrom :PreNatalOdontologico ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :SistemaEOR ;
            owl:onProperty :utiliza ],
        [ a owl:Restriction ;
            owl:onClass :AplicacaoDaEscalaDeEdimburgo ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :AvaliacaoDoEntendimentoDaImportanciaDaAmamentacao ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        :Pessoa .

:Gestacao a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Gestacao"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Concepto ;
            owl:onProperty gufo:mediates ],
        [ a owl:Restriction ;
            owl:onClass :IdadeGestacional ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :PeriodoGestacional ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :Gestante ;
            owl:onProperty [ owl:inverseOf gufo:mediates ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:Relator .

:Resultado a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Resultado"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDaEscalaDeEdimburgo ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDaEscalaDePittsburgh ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDaEscalaOHIP14 ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDoInstrumentoDeElegibilidade ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDoQuestionarioAUDIT ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDoQuestionarioInternacionalDeAtividadeFisica ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AplicacaoDoTesteDeFergstron ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AvaliacaoDaSaudeBucal ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AvaliacaoDoEntendimentoDaImportanciaDaAmamentacao ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AvaliacaoDosHabitosAlimentares ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AvaliacaoDosHabitosDeVida ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :AvaliacaoPsicossocialDaGestante ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .

:Frequencia a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Frequencia"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ConsumoDeBebidaAlcoolica ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ConsumoDeNicotina ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DisturbioDoSono ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :ImpactoDaSaudeBucalNaQualidadeDeVida ;
            owl:onProperty gufo:inheresIn ],
        [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Sintoma ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .


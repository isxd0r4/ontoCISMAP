:Inclusao a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Inclusao"@en ;
    rdfs:subClassOf gufo:Relator .

:Parede a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Parede"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :cimento :metal :pedra :plastico :sape :tijoloDeBarro ) ] .

:RegiaoCorporal a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Regiao Corporal"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :face :membroInferior :membroSuperior :regiaoPreMaleolar :regiaoPreTibial :regiaoSacral ) ] .

:SaudeBucalDaGestante a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Saude Bucal da Gestante"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Gestante ;
            owl:onProperty gufo:inheresIn ],
        gufo:IntrinsicMode .

:TipoDeAnemia a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Anemia"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :anemiaFalciforme :anemiaFerropriva :anemiaMegaloblastica :anemiaMicroangiopatica :hemoglobinopatias :talassemia ) ] .

:TipoDeIntercorrencia a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Intercorrencia"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :convulsoes :diabetes_intercorrencia :febre :hemorragia :hipertensao :sensibilizacaoRh ) ] .

:TipoDeMotivoDaCesarea a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Motivo da Cesarea"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :bebeEmSofrimento :bebeSentado :diabetes :escolhaDaGestante :placentaPrevia :pressaoAlta ) ] .

:AspectoDaFeridaCirurgica a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Aspecto da Ferida Cirurgica"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :FeridaCirurgica ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .

:ComplicacaoNoRecemNascido a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Complicacao no Recem-Nascido"@en ;
    rdfs:subClassOf gufo:Event .

:Logradouro a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Logradouro"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:Mama a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Mama"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Fissura ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Hiperemia ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        [ a owl:Restriction ;
            owl:maxQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :IngurgitamentoMamario ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ],
        gufo:FunctionalComplex .

:Questionario a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Questionario"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:SintomaDeDependenciaDeNicotina a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Sintoma De Dependencia de Nicotina"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :DependenciaDeNicotina ;
            owl:onProperty gufo:inheresIn ],
        :Sintoma .

:TipoDeAuxilioDoGoverno a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Auxilio do Governo"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :proJovemAdolescente :programaBolsaFamilia :programaDeApoioAConservacaoAmbiental :programaDeErradicacaoDoTrabalhoInfantil :programaDeFomentoAsAtividadesProdutivasRurais :programaMinhaCasaMinhaVida :tarifaSocialDeEnergiaEletrica ) ] .

:TipoDeRiscoOcupacional a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Risco Ocupacional"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :altoNivelDeExtresse :cargaHorariaExtensa :esforcoFisicoExcessivo :exposicaoAAgenteBiologico :exposicaoAAgenteFisico :exposicaoAAgenteQuimico :rotatividadeDeHorario ) ] .

:Dimensao a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Dimensao"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:Moradia a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Moradia"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:someValuesFrom :Compartimento ],
        [ a owl:Restriction ;
            owl:onClass :CondicaoDeMoradia ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        [ a owl:Restriction ;
            owl:onClass :LocalDeMoradia ;
            owl:onProperty [ owl:inverseOf gufo:inheresIn ] ;
            owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ],
        gufo:FunctionalComplex .

:SituacaoQueExigeCuidado a gufo:Category,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Situacao Que Exige Cuidado"@en ;
    rdfs:subClassOf gufo:FunctionalComplex .

:TipoDeProblemaCardiaco a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Problema Cardiaco"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :arritmias :cardiopatiaCongenita :cardiopatiaIsquemica :doencaDeChagas :doencaValvarCardiacaNaGestacao :endocardites :infartoAgudoDoMiocardio :miocardiaPeriparto ) ] .

:TipoDeViolenciaObstetrica a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Violencia Obstetrica"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :episiotomia :infusaoContinuaDeOcitocina :lavagemIntestinal :manobraDeKristeller :puxoDirigido :restricaoDaMovimentacao :rupturaArtificialDaBolsa :tricotomia ) ] .

:Fisico a gufo:SubKind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Fisico"@en ;
    rdfs:subClassOf :ProblemaDeSaude .

:LocalDeMoradia a gufo:Kind,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Local de Moradia"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Moradia ;
            owl:onProperty gufo:inheresIn ],
        gufo:Quality .

:Parto a gufo:EventType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Parto"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onClass :Puerperio ;
            owl:onProperty gufo:historicallyDependsOn ],
        :DesfechoDaGestacao .

:TipoDeMetodoContraceptivo a gufo:AbstractIndividualType,
        owl:Class,
        owl:NamedIndividual ;
    rdfs:label "Tipo de Metodo Contraceptivo"@en ;
    rdfs:subClassOf gufo:QualityValue ;
    owl:equivalentClass [ a owl:Class ;
            owl:oneOf ( :anticoncepcionalInjetavelMensal :anticoncepcionalInjetavelTrimestral :anticoncepcionalOral :diu :laqueadura :metodosComportamentais :preservativoFeminino :preservativoMasculino :vasectomia ) ] .

